# === Otak AI (wajib untuk mode nyata; kosongkan untuk mode mock/dry-run) ===
ANTHROPIC_API_KEY=

# === Email (SMTP untuk kirim, IMAP untuk baca balasan) ===
# Gmail: aktifkan 2FA lalu buat "App Password" di myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
EMAIL_FROM=

# === WhatsApp Business Cloud API (resmi Meta) ===
# Dari developers.facebook.com -> aplikasi -> WhatsApp -> API Setup
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=ganti-dengan-string-acak-rahasia
# Versi API Meta (opsional)
WA_API_VERSION=v21.0

# === Pemilik sistem (tujuan eskalasi Sentinel) ===
OWNER_EMAIL=
OWNER_PHONE=

# === Paksa mode mock walaupun kredensial terisi (true/false/auto) ===
FORCE_MOCK=auto
